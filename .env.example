# Copy to .env and fill in. Never commit real secrets.

# App under test
BASE_URL=http://localhost:3000

# Authentication (only what your run needs) — never commit real values
LOGIN_URL=/login
TEST_USER=
TEST_PASS=
# For token/bearer auth instead of form login:
TEST_TOKEN=

# Cookies to inject before tests (value only; name/domain set in the spec)
SESSION_COOKIE=

# Zoho QEngine — see reference/qengine.md
# Ingest endpoint OR Test Plan Execution URL (from the Test Plans section)
QENGINE_BASE_URL=
# Generate under: Setup -> API Keys
QENGINE_API_KEY=
# Optional build label (defaults to a timestamp)
QENGINE_BUILD_NAME=
# Optional HTTP timeout in seconds (default 30)
QENGINE_TIMEOUT_SECONDS=30
